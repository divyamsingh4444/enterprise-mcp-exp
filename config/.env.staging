# Staging Environment

# OAuth
MCP_SECRET_KEY=${STAGING_SECRET_KEY}
JWT_ALGORITHM=HS256

# Jaeger Tracing
JAEGER_HOST=jaeger.staging.internal
JAEGER_PORT=6831
JAEGER_SAMPLER=probabilistic
JAEGER_SAMPLER_PARAM=0.5

# Database (Supabase)
DATABASE_URL=${STAGING_DATABASE_URL}
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=${STAGING_SUPABASE_KEY}

# Server
DEBUG=False
LOG_LEVEL=INFO
ENVIRONMENT=staging
SERVICE_NAME=enterprise-mcp-staging

# Redis
REDIS_URL=${STAGING_REDIS_URL}
