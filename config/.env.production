# Production Environment

# OAuth
MCP_SECRET_KEY=${PROD_SECRET_KEY}
JWT_ALGORITHM=HS256

# Jaeger Tracing
JAEGER_HOST=jaeger.prod.internal
JAEGER_PORT=6831
JAEGER_SAMPLER=remote
JAEGER_SAMPLER_PARAM=0.1

# Database (Supabase)
DATABASE_URL=${PROD_DATABASE_URL}
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=${PROD_SUPABASE_KEY}

Database_password=95#%9GCx7sXrh*U

# Server
DEBUG=False
LOG_LEVEL=WARNING
ENVIRONMENT=production
SERVICE_NAME=enterprise-mcp-prod

# Redis
REDIS_URL=${PROD_REDIS_URL}
